estrutura Rational
    Inteiro num;
    Inteiro den;
fimEstrutura

funcao Rational criar(Inteiro a, Inteiro b)
    Rational r <- novo Rational();
    r.num <- a;
    r.den <- b;
    retorne r;
fimFuncao

funcao Booleano iguais(Rational r1, Rational r2)
    se ( (r1.num * r2.den) == (r2.num * r1.den) )
        retorne 1;
    senao
        retorne 0;
    fimSe
fimFuncao

funcao Rational somar(Rational r1, Rational r2)
    Inteiro n <- (r1.num * r2.den) + (r2.num * r1.den);
    Inteiro d <- r1.den * r2.den;
    retorne criar(n, d);
fimFuncao

funcao Rational subtrair(Rational r1, Rational r2)
    Inteiro n <- (r1.num * r2.den) - (r2.num * r1.den);
    Inteiro d <- r1.den * r2.den;
    retorne criar(n, d);
fimFuncao

funcao Rational multiplicar(Rational r1, Rational r2)
    retorne criar(r1.num * r2.num, r1.den * r2.den);
fimFuncao

funcao Rational dividir(Rational r1, Rational r2)
    retorne criar(r1.num * r2.den, r1.den * r2.num);
fimFuncao

funcao Inteiro imprimirRacional(Rational r)
    escreva("Racional: " + r.num + "/" + r.den);
    retorne 0;
fimFuncao

funcao Inteiro Main()
    escreva("=== PROBLEMA 4: Calculadora Racional ===");

    Inteiro n1; 
    Inteiro d1;
    Inteiro n2; 
    Inteiro d2;

    escreva("");
    escreva("--- Primeiro Numero ---");
    escreva("Digite o numerador:");
    leia(n1);
    escreva("Digite o denominador (diferente de 0):");
    leia(d1);

    Rational r1 <- criar(n1, d1);

    escreva("");
    escreva("--- Segundo Numero ---");
    escreva("Digite o numerador:");
    leia(n2);
    escreva("Digite o denominador (diferente de 0):");
    leia(d2);

    Rational r2 <- criar(n2, d2);

    escreva("");
    escreva("--- Resultados ---");
    
    escreva("Soma:");
    imprimirRacional(somar(r1, r2));

    escreva("Subtracao:");
    imprimirRacional(subtrair(r1, r2));

    escreva("Multiplicacao:");
    imprimirRacional(multiplicar(r1, r2));

    escreva("Divisao:");
    imprimirRacional(dividir(r1, r2));
    
    escreva("Verificacao de Igualdade:");
    se (iguais(r1, r2))
        escreva("Os numeros sao IGUAIS.");
    senao
        escreva("Os numeros sao DIFERENTES.");
    fimSe
    
    retorne 0;
fimFuncao