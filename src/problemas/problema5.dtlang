funcao Inteiro mdc(Inteiro n, Inteiro m, ref Inteiro r)

    se ( (m % n) == 0 )
        r <- n;
    senao
        se ( (n % m) == 0 )
            r <- m;
        senao
            se (n < m)
                mdc(n, m % n, r);
            senao
                 mdc(m, n % m, r);
            fimSe
        fimSe
    fimSe

    retorne 0;
fimFuncao

funcao Inteiro Main()
    escreva("=== PROBLEMA 5: MDC Recursivo ===");
    
    Inteiro n1;
    Inteiro n2;
    Inteiro resultado <- 0;

    escreva("Digite o primeiro numero: ");
    leia(n1);

    escreva("Digite o segundo numero: ");
    leia(n2);

    escreva("Calculando MDC...");

    mdc(n1, n2, &resultado);

    escreva("MDC encontrado: ");
    escreva(resultado);

    retorne 0;
fimFuncao